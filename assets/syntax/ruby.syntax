name = Ruby
ext = rb rake gemspec
file = Gemfile Rakefile
comment = #
string = " " escape
string = ' ' escape
prefix = constant :
prefix = variable @@
prefix = variable @
prefix = variable $
keyword = alias and class def defined module not or self super undef require attr_accessor attr_reader private public protected
control = begin break case do else elsif end ensure for if in next redo rescue retry return then unless until when while yield
plain = variable
constant = true false nil
builtin = puts print p raise lambda proc
after = function def
after = type class module
capitalized = type
