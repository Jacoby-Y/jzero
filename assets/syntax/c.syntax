# C and C++
name = C
ext = c h cpp hpp cc cxx hh hxx ino
comment = //
comment = /* */
string = " " escape
region = string ' ' char
prefix = annotation #
keyword = sizeof typedef struct union enum static extern const volatile register inline auto restrict class namespace template typename public private protected virtual override final friend operator new delete this using noexcept constexpr consteval static_cast dynamic_cast reinterpret_cast const_cast explicit mutable concept requires
control = if else for while do switch case default return break continue goto try catch throw co_await co_return co_yield
plain = variable
type = void char short int long float double signed unsigned bool size_t ssize_t int8_t int16_t int32_t int64_t uint8_t uint16_t uint32_t uint64_t uintptr_t wchar_t
constant = true false NULL nullptr
builtin = std printf malloc free memcpy memset strlen
after = type struct class union enum namespace
call = true
capitalized = type
