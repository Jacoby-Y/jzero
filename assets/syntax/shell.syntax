# sh, bash, zsh, fish and their rc files
name = Shell
ext = sh bash zsh fish ksh command
file = .bashrc .bash_profile .bash_aliases .profile .zshrc .zprofile .zshenv .xinitrc .xprofile PKGBUILD
comment = # alone
string = " " escape multiline
string = ' ' multiline
region = variable ${ }
region = string $( )
prefix = variable $
keyword = function local export readonly declare typeset unset shift source alias set end begin and or not switch
control = if then else elif fi for while until do done case esac in select return break continue
builtin = echo printf cd pwd test read eval exec exit trap kill wait jobs bg fg ls cat grep sed awk find mkdir rm cp mv chmod chown sudo git
key = =
after = function function
