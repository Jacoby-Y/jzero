#!/usr/bin/env bash
# JZero commands: one bash file of functions, one function per command.
#   0                 list commands
#   0 <name> [args]   run one
#   0 0               edit the file ($EDITOR, else vim)
# `split` and `island` commands ask JZero (OSC 7770 with this shell's $JZERO_TOKEN) to open a
# pane that runs `0 --pane <name> [args]`. Outside JZero they run inline.
f="${XDG_CONFIG_HOME:-$HOME/.config}/jzero/commands.sh"

template() {
    cat <<'EOF'
# JZero commands: `0 <name> [args]` runs function <name>; `0` lists them; `0 0` edits this file.
#
# One bash function per command. The first comment line right above a function is its
# description. `# @run <mode>` among those lines picks where it runs:
#   inline  (default) in the current terminal
#   split   in a new pane beside it
#   island  in a new island
#   bg      in the background; a desktop notification says when it is done
# Functions starting with `_` are helpers and are not listed. Arguments arrive as "$@".
# This file is plain bash (whatever your shell is) and is sourced fresh on every run.

# Say hello
hello() {
    echo "hello ${1:-world} from $PWD"
}
EOF
}

# One `name<TAB>mode<TAB>description` line per command, in file order.
commands() {
    awk '
        /^[ \t]*#/ {
            l = $0; sub(/^[ \t]*#[ \t]?/, "", l)
            if (l ~ /^@run[ \t]/) { sub(/^@run[ \t]+/, "", l); sub(/[ \t].*$/, "", l); mode = l }
            else if (desc == "") desc = l
            next
        }
        /^(function[ \t]+[A-Za-z0-9_][A-Za-z0-9_-]*|[A-Za-z0-9_][A-Za-z0-9_-]*[ \t]*\(\))/ {
            n = $0; sub(/^function[ \t]+/, "", n); sub(/[ \t({].*$/, "", n)
            if (substr(n, 1, 1) != "_") printf "%s\t%s\t%s\n", n, (mode == "" ? "inline" : mode), desc
        }
        { desc = ""; mode = "" }
    ' "$f"
}

# Source the file and call function "$1" with the rest.
run() { bash -c 'source "$1" || exit; shift; "$@"' 0 "$f" "$@"; }

# JZero's completion list (`features/zerocmds.j3`): the raw lines, nothing created.
[ "${1-}" = --list ] && { [ -f "$f" ] && commands; exit 0; }

[ -f "$f" ] || { mkdir -p "${f%/*}" && template > "$f"; }

case "${1-}" in
"")
    echo "JZero commands ($f):"
    commands | awk -F'\t' '{ printf "  %-16s %s%s\n", $1, $3, ($2 == "inline" ? "" : "  [" $2 "]") }'
    echo
    echo "0 <name> [args] runs one; 0 0 edits the file."
    exit 0 ;;
0) exec ${EDITOR:-vim} "$f" ;;
--pane)  # JZero's split / island pane: run, then hold the pane open until Enter
    shift
    run "$@"
    s=$?
    printf '\n[%s exited %d, press Enter to close]' "$1" "$s"
    read -r
    exit "$s" ;;
esac

bash -n "$f" || { echo "0: $f has a syntax error (0 0 to fix it)" >&2; exit 2; }
mode=$(commands | awk -F'\t' -v n="$1" '$1 == n { print $2; exit }')
[ -n "$mode" ] || { echo "0: no command '$1' (0 lists them, 0 0 edits them)" >&2; exit 127; }

case "$mode" in
split|island)
    if [ -n "${JZERO_TOKEN-}" ] && { { printf '\033]7770;%s;%s' "$JZERO_TOKEN" "$mode"
          for a in "$@"; do printf ';%s' "$(printf %s "$a" | base64 -w0)"; done
          printf '\007'; } > /dev/tty; } 2>/dev/null; then
        exit 0
    fi
    run "$@" ;;
bg)
    log="${TMPDIR:-/tmp}/jzero-0-$1.log"
    setsid bash -c '
        f=$1; log=$2; shift 2
        bash -c "source \"\$1\" || exit; shift; \"\$@\"" 0 "$f" "$@" > "$log" 2>&1
        s=$?
        command -v notify-send >/dev/null && notify-send -a JZero -- "0 $1 finished (exit $s)" "$(tail -n 1 "$log")"
    ' _ "$f" "$log" "$@" < /dev/null > /dev/null 2>&1 &
    echo "0: $1 running in the background (log: $log)" ;;
*) run "$@" ;;
esac
