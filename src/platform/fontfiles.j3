module jzero.platform.fontfiles;

use j3.io;
use j3.memory.Arena;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.text.Text;
use jzero.platform.os;

// Where this OS keeps fonts: the file for a family name, and the CJK and emoji fonts the
// terminal falls back to. Linux asks fontconfig (`fc-match`); Windows has no such program,
// so a family is found by its file name in the system and per-user font folders.

// CJK, then color emoji. ponytail: Debian/Ubuntu paths; a missing file loads empty.
const LINUX_FALLBACKS: [2]string = [
    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",
];
const WINDOWS_FALLBACKS: [2]string = ["msyh.ttc", "seguiemj.ttf"];  // Microsoft YaHei, Segoe UI Emoji
pub const FALLBACKS = 2;

// How a font file is named after its family (`Cascadia Mono` -> `CascadiaMono.ttf`).
const REGULAR: [3]string = ["", "-Regular", "Regular"];
const ITALIC: [4]string = ["-Italic", "Italic", "i", " Italic"];
const EXTS: [3]string = [".ttf", ".otf", ".ttc"];

// Fallback font `i` of `FALLBACKS` (frame scratch on Windows).
pub fn fallback(i: int): string {
    if !os.windows() { return LINUX_FALLBACKS[i]; }
    return Text.scratch().add(os.slashes(sys.env("WINDIR"))).add("/Fonts/").add(WINDOWS_FALLBACKS[i]).str();
}

// The font file of `family` (its italic with `italic`), in `mem`; "" when none is found.
pub fn find(family: string, italic: bool, mem: &Arena): string {
    if !os.windows() { return fcMatch(family, italic, mem); }
    // ponytail: by file name, so `Consolas` (consola.ttf) needs its path in the config; read
    // the registry's font list if j3 ever exposes it.
    let dirs: [2]string = [
        Text.new(mem).add(os.slashes(sys.env("WINDIR"))).add("/Fonts/").str(),
        Text.new(mem).add(os.slashes(sys.env("LOCALAPPDATA"))).add("/Microsoft/Windows/Fonts/").str(),
    ];
    let tight = Text.new(mem);
    for c in family { if c != 32 { tight.push(c); } }
    let stems: [2]string = [tight.str(), family];
    let styles = if italic { ITALIC[:] } else { REGULAR[:] };
    for dir in dirs {
        for stem in stems {
            for style in styles {
                for ext in EXTS {
                    let p = Text.new(mem).add(dir).add(stem).add(style).add(ext).str();
                    if io.exists(p) { return p; }
                }
            }
        }
    }
    return "";
}

// The file fontconfig picks for `family`, or "".
fn fcMatch(family: string, italic: bool, mem: &Arena): string {
    let pattern = Text.new(mem).add(family).add(if italic { ":italic" } else { "" }).str();
    let argv: [4]string = ["fc-match", "-f", "%{file}", pattern];
    match proc.run(argv[:], "", mem) {
        Result.Ok(o) {
            if o.code == 0 && o.out.len > 0 { return o.outStr(); }
        }
        Result.Err(_) {}
    }
    return "";
}
