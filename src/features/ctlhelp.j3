module jzero.features.ctlhelp;

// `jzctl`, `jzctl help [command]`, `jzctl <command> --help` (and `jzero --help`): the control
// command's help, printed here so it works without a running JZero. Written for someone (or
// an agent) who has never seen JZero. Keep in step with `state/ctl.j3` and `docs/ctl.md`.

use jzero.features.ctl;

const OVERVIEW = "jzctl: control the running JZero terminal from any shell (scripts, AI agents).\n\nEvery pane has a stable number (its id). `self` means the pane you are typing in.\n\n  jzctl ls [--json]                 list panes: id, island, focused (*), program, cwd\n  jzctl new split|island [-- cmd]   open a pane running cmd (default: a shell); prints its id\n  jzctl run <id> <command>          run command at the pane's prompt; print its output, exit with its code\n  jzctl read <id> [--lines N]       print what the pane shows (N: last N lines, with scrollback)\n  jzctl watch <id>                  print the pane's new output as it comes (Ctrl+C stops)\n  jzctl send <id> <text> [--enter]  type text into the pane; --enter presses Enter after it\n  jzctl key <id> <key>              press one key (enter, ctrl+c, up, ...)\n  jzctl wait <id> --match <text>    block until text is on the pane's screen\n  jzctl wait <id> --idle <ms>       block until the pane prints nothing for <ms>\n  jzctl wait <id> --prompt          block until the shell shows its prompt\n  jzctl status <id> [--json]        running or idle, last exit code, duration, command\n  jzctl history <id> [--lines N]    commands run in the pane\n  jzctl search <text> [--json]      find text in every pane's output and commands, closed islands too\n  jzctl open <file>[:line]          show a file (or folder) in an explorer pane beside this one\n  jzctl notify <text>               desktop notification\n  jzctl badge <id> [text]           show text on the pane until the user types in it (no text clears)\n  jzctl focus <id>                  show the pane to the user\n  jzctl kanban ...                  list, show and edit kanban boards (jzctl help kanban)\n  jzctl close <id> [--force]        close the pane\n  jzctl serve [--port N] [--bind IP] phone page to read and type into panes (LAN/Tailscale; docs/remote.md)\n\nRun a command in another pane and read the result:\n  p=$(jzctl new split)\n  jzctl run $p 'make test' --timeout 60000\n\nExit codes: 0 ok, 1 error (reason on stderr), 2 JZero not running, 3 wait timed out\n(`run`: the command's own exit code). Details and examples: jzctl help <command>\n\nStarting the app instead: jzero [-e cmd] [--working-directory DIR] [--title T] [--class NAME] [--toggle]\n";

// One page per subcommand, in `ctl.NAMES` order.
const PAGES: [17]string = [
    "jzctl ls [--json]\n\nList every pane in the open islands, one per line, tab-separated:\n  id  island  *  program  cwd\n`*` marks the pane the user is looking at (`-` for the others). program is what runs in\nthe pane right now (the shell when idle; `explorer` for a file explorer pane).\n--json prints an array of {id, island, focused, program, cwd, wants}; wants is true after a\nbell, notification or badge the user has not answered by typing.\n\nExample:\n  jzctl ls\n  4\tdev\t*\tbash\t~/code/app\n  7\tdev\t-\tnpm\t~/code/app\n",
    "jzctl new split [--in <id>] [-- cmd args...]\njzctl new island [-- cmd args...]\n\nOpen a pane and print its id. `split` puts it to the right of a pane: --in <id>, else the\npane you run this from, else the focused one; it starts in that pane's directory. `island`\nopens a new island (a tab) with one pane. With `-- cmd`, the pane runs cmd instead of a\nshell, and closes when cmd exits.\n\nExamples:\n  p=$(jzctl new split)              # a shell beside this pane\n  jzctl new island -- htop          # htop in a new island\n  jzctl new split --in 7 -- claude  # beside pane 7\n",
    "jzctl send <id> <text> [--enter]\n\nType text into pane <id>, as a paste (newlines in it do not run anything). The command\nonly runs if you add --enter, which presses Enter after the text. To run a command and\nget its output, `jzctl run` is simpler.\n\nExamples:\n  jzctl send 7 'ls -la' --enter     # run ls in pane 7\n  jzctl send 7 'y'                  # type y, no Enter\n  jzctl send self 'echo hi'         # into your own pane\n",
    "jzctl key <id> <key>\n\nPress one key in pane <id>. Keys: enter tab esc backspace delete up down left right,\nor ctrl+<letter> (lowercase, e.g. ctrl+c to interrupt, ctrl+d to end input).\n\nExamples:\n  jzctl key 7 ctrl+c                # stop what runs in pane 7\n  jzctl key 7 up && jzctl key 7 enter   # rerun the last command\n",
    "jzctl read <id> [--lines N] [--json]\n\nPrint the text pane <id> shows right now (plain text, no colors). With --lines N, print\nits last N lines instead, reaching back into scrollback. It is a snapshot: to follow\noutput, `jzctl watch`, or `jzctl wait` first, then read. --json prints {id, text}.\n\nExamples:\n  jzctl read 7                      # the visible screen\n  jzctl read 7 --lines 200          # the last 200 lines\n",
    "jzctl wait <id> --match <text> [--timeout <ms>]\njzctl wait <id> --idle <ms> [--timeout <ms>]\njzctl wait <id> --prompt [--timeout <ms>]\n\nBlock until pane <id> is ready, then exit 0.\n  --match <text>   until <text> appears on its screen (plain text, not a regex)\n  --idle <ms>      until it has printed nothing for <ms> (a command finished or waits)\n  --prompt         until the shell waits at its prompt (needs shell integration;\n                   at once if it already does)\n  --timeout <ms>   give up after <ms> and exit 3 (default: wait forever)\nIt exits 1 if the pane closes while waiting.\n\nExamples:\n  jzctl wait 7 --prompt --timeout 30000      # until the shell is ready\n  jzctl wait 7 --idle 1500                   # until output settles\n",
    "jzctl focus <id>\n\nShow pane <id> to the user: opens its island and moves the keyboard focus to it.\n\nExample:\n  jzctl focus 7\n",
    "jzctl close <id> [--force]\n\nClose pane <id>. Refused (exit 1) while a program runs in it or a file in it has unsaved\nchanges; --force closes anyway.\n\nExamples:\n  jzctl close 7\n  jzctl close 7 --force\n",
    "jzctl run <id> <command> [--timeout <ms>]\n\nRun <command> in pane <id> as if typed there: waits for the shell's prompt, types it,\npresses Enter, waits for it to end, then prints its output and exits with its exit code.\nNeeds shell integration (a JZero shell has it; ssh and programs do not). --timeout gives\nup after <ms> and exits 3 (the command keeps running).\n\nExamples:\n  p=$(jzctl new split)\n  jzctl run $p 'make test' --timeout 600000 || echo failed\n  jzctl run self 'ls'               # not from inside the same pane: it waits for itself\n",
    "jzctl watch <id> [--lines N]\n\nPrint pane <id>'s output as it comes, line by line, like `tail -f`, until the pane closes\n(exit 1) or Ctrl+C. A line prints once the program moves past it. --lines N starts with\nthe last N lines already there.\n\nExamples:\n  jzctl watch 7\n  jzctl watch 7 --lines 20 | grep -i error\n",
    "jzctl status <id> [--json]\n\nPrint pane <id>'s shell state, tab-separated:\n  running|idle  exit  ms  command\nexit is the last command's exit code (-1 before any ended); ms is how long it ran, or how\nlong the running one has run so far; command is the last (or running) command line.\n--json prints {id, state, exit, ms, command, program, integration}; integration is false\nwhen the pane has no shell integration (then state and exit say nothing).\n\nExample:\n  jzctl status 7\n  idle\t0\t1520\tmake test\n",
    "jzctl history <id> [--lines N] [--json]\n\nPrint the commands run in pane <id>, oldest first, one per line (the last 50 are kept).\n--lines N prints only the last N; --json prints an array of strings.\n\nExample:\n  jzctl history 7 --lines 5\n",
    "jzctl notify <text> [--title <title>]\n\nShow a desktop notification (title defaults to JZero). Nothing shows when notifications\nare off in the settings.\n\nExample:\n  make build; jzctl notify \"build done: $?\"\n",
    "jzctl badge <id> [text]\n\nShow <text> in a box at the top right of pane <id>, and mark its island in the taskbar\nwhen another island shows. It stays until the user types in that pane, or until\n`jzctl badge <id>` with no text clears it. For an agent asking for attention.\n\nExamples:\n  jzctl badge self 'needs input'\n  jzctl badge 7\n",
    "jzctl search <text> [--max N] [--json]\n\nFind lines containing <text> (2+ characters, any case) in every pane's commands and\noutput (scrollback), closed islands included. One hit per line, commands first, newest\nfirst, at most N (default 50), tab-separated:\n  id  island  cmd|out  line\n--json prints an array of {id, island, open, kind, line}.\n\nExample:\n  jzctl search 'connection refused'\n",
    "jzctl open <path>[:line] [--in <id>]\n\nOpen a file in an explorer pane (JZero's editor), split to the right of --in <id>, else\nthe pane you run this from, else the focused one, and print the new pane's id. With\n:line the caret goes to that line. A folder opens as its file tree.\n\nExamples:\n  jzctl open src/main.c:120\n  jzctl open .                      # this folder's tree\n",
    "jzctl kanban ls [--json]\njzctl kanban show <board> [--json]\njzctl kanban new|rm <board>\njzctl kanban rename <board> <new name>\njzctl kanban col add <board> <name>\njzctl kanban col rename <board> <col> <name>\njzctl kanban col rm <board> <col>\njzctl kanban col mv <board> <col> <to>\njzctl kanban card add <board> <col> <title> [--body <text>]\njzctl kanban card edit <board> <col> <card> [--title <t>] [--body <text>]\njzctl kanban card rm <board> <col> <card>\njzctl kanban card mv <board> <col> <card> <to col> [<before>]\n\nThe kanban boards (taskbar button above notes). Each board has columns of cards; a card has\na title and a body (any number of lines). <col> is a column's number or its exact name;\n<card> is a card's number within its column. `show` prints the numbers:\n  ## 0 Back Burner\n  - 0 Write docs\n    body lines, indented\nNumbers shift after rm and mv: run `show` again before the next change. `new` makes the\nBack Burner / Front Burner / In Progress / Done / Canceled columns. `col add` and `card add` print the new number. `card mv`\nputs the card before card <before> of <to col> (numbered as now), or at the end without it;\n`col mv` puts the column at position <to>. --json: ls is an array of names, show is\n{name, columns: [{name, cards: [{title, body}]}]}. Names and titles are one line.\nBoards are files in ~/.local/share/jzero/kanban/<board>.md; the view updates live.\n\nExamples:\n  jzctl kanban new release\n  jzctl kanban card add release 'Back Burner' 'Tag v2' --body 'after CI is green'\n  jzctl kanban card mv release 'Back Burner' 0 Done\n  jzctl kanban show release --json\n",
];

// This run asks for help: bare `jzctl`, `help`, `--help`, `-h`, or `jzctl <command> --help|-h`.
pub fn wanted(): bool {
    if ctl.argCount() < 2 { return ctl.invoked(); }
    if isHelp(ctl.arg(1)) { return true; }
    return ctl.isCommand() && ctl.argCount() > 2 && isHelp(ctl.arg(2));
}

// Print the page asked for: a command's, else the overview.
pub fn print() {
    let topic = ctl.arg(1);
    if isHelp(topic) {
        topic = "";
        if ctl.argCount() > 2 { topic = ctl.arg(2); }
    }
    let k = ctl.command(topic);
    if k < 0 { ctl.writeFd(1, OVERVIEW); return; }
    ctl.writeFd(1, PAGES[k]);
}

fn isHelp(a: string): bool { return a == "help" || a == "--help" || a == "-h"; }
