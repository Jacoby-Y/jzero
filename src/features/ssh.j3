module jzero.features.ssh;

use j3.io;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys;
use j3.text.Text;
use jzero.config.parse.trim;
use jzero.platform.os;

// Host names from `~/.ssh/config` (`Host a b` lines; patterns with * ? ! are skipped).
// Strings live in `mem`.
pub fn hosts(mem: &Arena, out: &List<string>) {
    let path = Text.new(mem);
    path.pushStr(os.home());
    path.pushStr("/.ssh/config");
    match io.readFile(path.str(), mem) {
        Result.Ok(bytes) { parseHosts(bytes as string, out); }
        Result.Err(_) {}
    }
}

pub fn parseHosts(src: string, out: &List<string>) {
    let start = 0;
    while start < src.len {
        let end = start;
        while end < src.len && src[end] != 10 { end += 1; }
        let line = trim(src[start..end]);
        start = end + 1;
        if line.len < 5 || lower(line[0]) != 104 || !sameWord(line[0..4], "host") || !isSpace(line[4]) { continue; }
        let i = 5;
        while i < line.len {
            while i < line.len && isSpace(line[i]) { i += 1; }
            let w = i;
            while i < line.len && !isSpace(line[i]) { i += 1; }
            let name = line[w..i];
            if name.len > 0 && !isPattern(name) && name[0] != 35 { out.push(name); }
        }
    }
}

fn isPattern(s: string): bool {
    for i in 0..s.len { if s[i] == 42 || s[i] == 63 || s[i] == 33 { return true; } }
    return false;
}

fn isSpace(c: u8): bool { return c == 32 || c == 9; }

fn lower(c: u8): u8 {
    if c >= 65 && c <= 90 { return c + 32; }
    return c;
}

fn sameWord(a: string, b: string): bool {
    if a.len != b.len { return false; }
    for i in 0..a.len { if lower(a[i]) != b[i] { return false; } }
    return true;
}

// Self-check: plain hosts kept, patterns and other keys skipped.
pub fn selfTest(mem: &Arena) {
    let out = List<string>.new(mem);
    parseHosts("# c\nHost devbox web\n  HostName 1.2.3.4\nhost *.corp\nHost   pi !bad\nHostName x\nMatch all\n", &out);
    if out.len != 3 || out.items[0] != "devbox" || out.items[1] != "web" || out.items[2] != "pi" {
        sys.panic("ssh selfTest: hosts");
    }
}
