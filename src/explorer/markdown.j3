module jzero.explorer.markdown;

use j3.memory.List;
use j3.sys;
use j3.memory.Arena;
use j3.ui.spans.{ Span, SPAN_BOLD, SPAN_ITALIC, SPAN_COLOR };

// Markdown styled in place (the source stays visible, like Obsidian's source mode):
// headings bold + colored, **bold**, *italic* / _italic_, `code` and ``` fences, list and quote
// markers, [links](url) and [[wikilinks]].
// ponytail: line-based, no nesting or escapes; a real CommonMark pass if people ask.

// `colors` by highlight kind: comment, string, number, keyword, type.
const QUOTE = 0;
const CODE = 1;
const MARKER = 2;
const HEADING = 3;
const LINK = 4;

pub fn spans(text: string, out: &List<Span>, colors: []string) {
    let fence = false;
    let i = 0;
    while i < text.len {
        let end = i;
        while end < text.len && text[end] != 10 { end += 1; }
        let line = text[i..end];
        if startsWith(line, "```") {
            fence = !fence;
            color(out, i, end - i, colors[CODE]);
        } else if fence {
            color(out, i, end - i, colors[CODE]);
        } else {
            styleLine(text, i, end, out, colors);
        }
        i = end + 1;
    }
}

fn styleLine(text: string, start: int, end: int, out: &List<Span>, colors: []string) {
    let k = start;
    while k < end && text[k] == 32 { k += 1; }
    let h = k;
    while h < end && text[h] == 35 { h += 1; }
    if h > k && (h == end || text[h] == 32) {
        color(out, start, end - start, colors[HEADING]);
        out.push(Span { start: start, len: end - start, kind: SPAN_BOLD, data: "" });
        return;
    }
    if k < end && text[k] == 62 {
        color(out, start, end - start, colors[QUOTE]);
        return;
    }
    let m = markerEnd(text, k, end);
    if m > k { color(out, k, m - k, colors[MARKER]); k = m; }
    inline(text, k, end, out, colors);
}

// End of a list marker at `k` (`- `, `* `, `+ `, `12. `), or `k` when there is none.
pub fn markerEnd(text: string, k: int, end: int): int {
    if k + 1 < end && (text[k] == 45 || text[k] == 42 || text[k] == 43) && text[k + 1] == 32 { return k + 2; }
    let d = k;
    while d < end && text[d] >= 48 && text[d] <= 57 { d += 1; }
    if d > k && d + 1 < end && text[d] == 46 && text[d + 1] == 32 { return d + 2; }
    return k;
}

fn inline(text: string, from: int, end: int, out: &List<Span>, colors: []string) {
    let i = from;
    while i < end {
        let c = text[i];
        let stop = -1;
        if c == 96 {
            stop = close(text, i + 1, end, "`");
            if stop > 0 { color(out, i, stop - i, colors[CODE]); }
        } else if c == 42 && at(text, i + 1, end) == 42 {
            stop = close(text, i + 2, end, "**");
            if stop > 0 { out.push(Span { start: i, len: stop - i, kind: SPAN_BOLD, data: "" }); }
        } else if (c == 42 || (c == 95 && (i == from || !isWord(text[i - 1])))) && at(text, i + 1, end) != 32 {
            let q: string = if c == 42 { "*" } else { "_" };
            stop = close(text, i + 1, end, q);
            if stop > 0 { out.push(Span { start: i, len: stop - i, kind: SPAN_ITALIC, data: "" }); }
        } else if c == 91 && at(text, i + 1, end) == 91 {
            stop = close(text, i + 2, end, "]]");
            if stop > 0 { color(out, i, stop - i, colors[LINK]); }
        } else if c == 91 {
            stop = close(text, i + 1, end, "](");
            if stop > 0 { stop = close(text, stop, end, ")"); }
            if stop > 0 { color(out, i, stop - i, colors[LINK]); }
        }
        if stop > 0 { i = stop; } else { i += 1; }
    }
}

// Index past the first `q` in `from..end`, or -1.
pub fn close(text: string, from: int, end: int, q: string): int {
    let k = from;
    while k + q.len <= end {
        if text[k..k + q.len] == q && k > from { return k + q.len; }
        k += 1;
    }
    return -1;
}

fn color(out: &List<Span>, start: int, len: int, c: string) {
    if len > 0 { out.push(Span { start: start, len: len, kind: SPAN_COLOR, data: c }); }
}

fn at(s: string, i: int, end: int): u8 { if i < end { return s[i]; } return 0; }
pub fn isWord(c: u8): bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95; }
pub fn startsWith(s: string, p: string): bool { return s.len >= p.len && s[0..p.len] == p; }

// Self-check: heading, list marker, bold, italic, code, link, fence; snake_case stays plain.
pub fn selfTest(mem: &Arena) {
    let out = List<Span>.new(mem);
    let cs: [5]string = ["q", "s", "n", "k", "t"];
    spans("# Hi\n- **b** *i* `c` [[w]] snake_case\n```\nx\n```", &out, cs[:]);
    let s = out.items[0..out.len];
    check(s.len == 10, "count");
    check(s[0].data == "k" && s[1].kind == SPAN_BOLD && s[1].len == 4, "heading");
    check(s[2].data == "n" && s[2].start == 5 && s[2].len == 2, "marker");
    check(s[3].kind == SPAN_BOLD && s[3].len == 5, "bold");
    check(s[4].kind == SPAN_ITALIC && s[4].len == 3, "italic");
    check(s[5].data == "s" && s[5].len == 3, "code");
    check(s[6].data == "t" && s[6].len == 5, "wikilink");
    check(s[7].data == "s" && s[8].data == "s" && s[9].data == "s", "fence");
}

fn check(ok: bool, what: string) { if !ok { sys.panic(`markdown selfTest: {what}`); } }
